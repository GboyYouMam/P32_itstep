@model WebApplication1.Models.TagViewModel

@{
    ViewData["Title"] = $"Details of {Model.Name}";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-5">
    <h2 class="mb-0">📌 Tag Details</h2>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-warning me-2">Edit</a>
        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-sm btn-outline-danger">Delete</a>
    </div>
</div>

<div class="card shadow-sm p-4">
    <dl class="row mb-0">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Notes</dt>
        <dd class="col-sm-10">
            <div class="overflow-auto border rounded p-3" style="max-height: 300px;">
                @if (ViewBag.Notes != null && ((IEnumerable<dynamic>)ViewBag.Notes).Any())
                {
                    foreach (var note in ViewBag.Notes)
                    {
                        <span class="badge bg-secondary me-1 mb-1 d-inline-flex align-items-center">
                            @note.Title&nbsp;
                            <a asp-controller="Notes" asp-action="Details" asp-route-id="@note.Id" class="text-red ms-1 text-decoration-none" title="View Note Details">
                                >
                            </a>
                        </span>
                    }
                }
                else
                {
                    <span class="text-muted">No notes found.</span>
                }
            </div>
        </dd>
    </dl>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">Back to Tags</a>
</div>