@model WebApplication1.Models.TagViewModel

@{
    ViewData["Title"] = "Delete Tag";
}

<h2>Delete Tag</h2>

<h3>Are you sure you want to delete this?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Notes</dt>
        <dd class="col-sm-10">
            <div style="max-height: 300px; overflow-y: auto; border: 1px solid #ddd; padding: 8px;">
                @if (ViewBag.Notes != null)
                {
                    foreach (var note in ViewBag.Notes)
                    {
                        <span class="badge bg-secondary" style="margin-bottom: 4px; display: inline-block;">
                            @note.Title
                            <a asp-controller="Notes" asp-action="Details" asp-route-id="@note.Id">Details</a>
                        </span>
                    }
                }
                else
                {
                    <span>No notes found.</span>
                }
            </div>
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>

