@model WebApplication1.Models.TagViewModel

@{
    ViewData["Title"] = "Delete Tag";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-5">
    <h2 class="mb-0 text-danger">🗑️ Delete Tag</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to Tags</a>
</div>

<div class="card shadow-sm p-4">
    <h5>Are you sure you want to delete this tag?</h5>
    <dl class="row mb-3">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">Notes</dt>
        <dd class="col-sm-10">
            <div class="overflow-auto border rounded p-3" style="max-height: 300px;">
                @if (ViewBag.Notes != null && ((IEnumerable<dynamic>)ViewBag.Notes).Any())
                {
                    foreach (var note in ViewBag.Notes)
                    {
                        <span class="badge bg-secondary me-1 mb-1 d-inline-flex align-items-center">
                            @note.Title&nbsp;
                            <a asp-controller="Notes" asp-action="Details" asp-route-id="@note.Id" class="text-white ms-1 text-decoration-none" title="View Note Details">
                                <i class="bi bi-box-arrow-up-right"></i>
                            </a>
                        </span>
                    }
                }
                else
                {
                    <span class="text-muted">No notes found.</span>
                }
            </div>
        </dd>
    </dl>

    <form asp-action="Delete" method="post">
        <button type="submit" class="btn btn-danger me-2">Delete</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>