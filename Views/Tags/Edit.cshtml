@model WebApplication1.Models.TagViewModel

@{
    ViewData["Title"] = "Edit Tag";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-5">
    <h2 class="mb-0">✏️ Edit Tag</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">Back to Tags</a>
</div>

<div class="card shadow-sm p-4 col-md-5">
    <form asp-action="Edit" method="post" novalidate>
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-warning">Save Changes</button>
    </form>
</div>