@model IEnumerable<WebApplication1.Models.TagViewModel>

@{
    ViewData["Title"] = "Tags";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-5">
    <h2 class="mb-0">📌 Tags Overview</h2>
    <a asp-action="Create" class="btn btn-success">+ Create Tag</a>
</div>

<table class="table table-hover table-striped border rounded shadow">
    <thead class="table-dark">
    <tr>
        <th>Name</th>
        <th>Used In Notes</th>
        <th class="text-end">Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var tag in Model)
    {
        <tr>
            <td class="align-middle">@tag.Name</td>
            <td class="align-middle">@tag.NotesId.Count</td>
            <td class="text-end">
                <a asp-action="Details" asp-route-id="@tag.Id" class="btn btn-sm btn-outline-primary me-1">Details</a>
                <a asp-action="Edit" asp-route-id="@tag.Id" class="btn btn-sm btn-outline-warning me-1">Edit</a>
                <a asp-action="Delete" asp-route-id="@tag.Id" class="btn btn-sm btn-outline-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>

@if (ViewBag.TotalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link bg-dark text-light border-dark" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage - 1)">Previous</a>
            </li>
            
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link bg-dark text-light border-dark @(i == ViewBag.CurrentPage ? "active bg-secondary" : "")" 
                       asp-action="Index" 
                       asp-route-page="@i">@i</a>
                </li>
            }
            
            <li class="page-item @(ViewBag.CurrentPage >= ViewBag.TotalPages ? "disabled" : "")">
                <a class="page-link bg-dark text-light border-dark" asp-action="Index" asp-route-page="@(ViewBag.CurrentPage + 1)">Next</a>
            </li>
        </ul>
    </nav>
}
