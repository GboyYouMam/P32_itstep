@model WebApplication1.Models.NoteViewModel
@{
    ViewData["Title"] = "Note Details";
}

<div class="container mt-5">
    <div class="card shadow-sm">
        <div class="card-header bg-info text-white">
            <h3>Note Details</h3>
        </div>
        <div class="card-body">
            <dl class="row mb-4">
                <dt class="col-sm-2">Title</dt>
                <dd class="col-sm-10">@Model.Title</dd>

                <dt class="col-sm-2">Content</dt>
                <dd class="col-sm-10">@Model.Content</dd>

                <dt class="col-sm-2">Tags</dt>
                <dd class="col-sm-10">
                    @foreach (var tag in ViewBag.Tags)
                    {
                        <span class="badge bg-secondary me-1">@tag.Name</span>
                    }
                </dd>
            </dl>

            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning me-2">Edit</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger me-2">Delete</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
        </div>
    </div>
</div>