@using System.ComponentModel.DataAnnotations
@model WebApplication1.Models.NoteViewModel
@{
    ViewData["Title"] = "Create Note";
}

<h2>Create Note</h2>

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post">
            <div>
                <label asp-for="Title">Title</label><br/>
                <input asp-for="Title" /><br/>
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="Content">Content</label><br/>
                <textarea asp-for="Content" rows="5"></textarea><br/>
                <span asp-validation-for="Content" class="text-danger"></span>
            </div>
            <div>
                <label asp-for="TagsId"></label><br/>
                <select asp-for="TagsId" asp-items="ViewBag.Tags" multiple="multiple" class="form-control"></select>
                <span asp-validation-for="TagsId" class="text-danger"></span>
            </div>
            <button type="submit">Create Note</button>
        </form>
    </div>
</div>
<div>
    <a asp-action="Index">Back to Notes</a>
</div>