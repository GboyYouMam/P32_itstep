@using WebApplication1.Entities
@model IEnumerable<WebApplication1.Entities.NoteEntity>

<div>
    <h2>Notes</h2>
    
    <table class="table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Content</th>
                @*<th>Tags</th>*@
                <th>Created At</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var note in Model)
        {
            <tr>
                <td>@note.Title</td>
                <td>@note.Content</td>
                <td>@note.CreatedAt.ToString("g")</td>
            </tr>
        }
        </tbody>
        </table>
</div>