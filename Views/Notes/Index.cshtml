@using WebApplication1.Entities
@model IEnumerable<WebApplication1.Entities.NoteEntity>

<div>
    <h2>Notes</h2>
    <a asp-action="Create">Create new!</a>
    
    <table class="table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Content</th>
                <th>Created At</th>
                <th>Tags</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var note in Model)
        {
            <tr>
                <td>@note.Title</td>
                <td>@note.Content</td>
                <td>@note.CreatedAt.ToString("g")</td>
                @foreach(var tag in note.Tags)
                {
                    <td>@tag.Name</td>
                }
            </tr>
        }
        </tbody>
        </table>
</div>