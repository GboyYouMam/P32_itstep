@model IEnumerable<WebApplication1.Models.NoteViewModel>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Your Notes</h2>
        <a asp-action="Create" class="btn btn-success">+ New Note</a>
    </div>

    <table class="table table-hover shadow-sm">
        <thead class="table-light">
        <tr>
            <th>Title</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var note in Model)
        {
            <tr>
                <td>@note.Title</td>
                <td>
                    <a asp-action="Details" asp-route-id="@note.Id" class="btn btn-sm btn-outline-primary">View</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>