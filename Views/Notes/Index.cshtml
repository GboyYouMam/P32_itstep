@using WebApplication1.Controllers
@using WebApplication1.Models
@model IEnumerable<WebApplication1.Models.NoteViewModel>

<div>
    <h2>Notes</h2>
    <a asp-action="Create">Create new!</a>
    
    <table class="table">
        <thead>
        <tr>
            <th>Title</th>
            <th></th>
        </tr>
        </thead>
        <tbody>
        @foreach (var note in Model)
        {
            <tr>
                <td>@note.Title</td>
                
                <td><a asp-action="Details" asp-route-id="@note.Id">Detailed</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>
