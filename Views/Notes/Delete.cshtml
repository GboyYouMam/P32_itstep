@model WebApplication1.Models.NoteViewModel
@{
    ViewData["Title"] = "Delete Note";
}

<div class="container mt-5">
    <div class="card border-danger shadow-sm">
        <div class="card-header bg-danger text-white">
            <h3>Delete Note</h3>
        </div>
        <div class="card-body">
            <h5 class="mb-3">Are you sure you want to delete this note?</h5>
            <dl class="row">
                <dt class="col-sm-2">Title</dt>
                <dd class="col-sm-10">@Model.Title</dd>

                <dt class="col-sm-2">Content</dt>
                <dd class="col-sm-10">@Model.Content</dd>

                <dt class="col-sm-2">Tags</dt>
                <dd class="col-sm-10">
                    @foreach (var tag in ViewBag.Tags)
                    {
                        <span class="badge bg-secondary">@tag.Name</span>
                    }
                </dd>
            </dl>

            <form asp-action="Delete">
                <button type="submit" class="btn btn-danger me-2">Confirm Delete</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>